+NativeStatus UnoQDumpPort::beginFifo() {
+    // No polling: immediate readbacks may conservatively refuse physical setup.
+    baud_register_ = 355556U;
+    for (unsigned i = 0U; i < 8U; ++i) clock_registers_[i] = clockRegister(i);
