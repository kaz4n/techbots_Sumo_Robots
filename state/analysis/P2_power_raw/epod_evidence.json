        [
          486,
          "#if defined(STM32_PLL_ENABLED)"
        ],
        [
          487,
          "/*"
        ],
        [
          488,
          " * Dynamic voltage scaling:"
        ],
        [
          489,
          " * Enable the Booster mode before enabling then PLL for sysclock above 55MHz"
        ],
        [
          490,
          " * The goal of this function is to set the epod prescaler, so that epod clock freq"
        ],
        [
          491,
          " * is between 4MHz and 16MHz."
        ],
        [
          492,
          " * Up to now only MSI as PLL1 source clock can be > 16MHz, requiring a epod prescaler > 1"
        ],
        [
          493,
          " * For HSI16, epod prescaler is default (div1, not divided)."
        ],
        [
          494,
          " * Once HSE is > 16MHz, the epod prescaler would also be also required."
        ],
        [
          495,
          " */"
        ],
        [
          496,
          "static void set_epod_booster(void)"
        ],
        [
          497,
          "{"
        ],
        [
          498,
          "\t/* Reset Epod Prescaler in case it was set earlier with another DIV value */"
        ],
        [
          499,
          "\tLL_PWR_DisableEPODBooster();"
        ],
        [
          500,
          "\twhile (LL_PWR_IsActiveFlag_BOOST() == 1) {"
        ],
        [
          501,
          "\t}"
        ],
        [
          502,
          ""
        ],
        [
          503,
          "\tLL_RCC_SetPll1EPodPrescaler(LL_RCC_PLL1MBOOST_DIV_1);"
        ],
        [
          504,
          ""
        ],
        [
          505,
          "\tif (MHZ(55) <= CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC) {"
        ],
        [
          506,
          "\t\t/*"
        ],
        [
          507,
          "\t\t * Set EPOD clock prescaler based on PLL1 input freq"
        ],
        [
          508,
          "\t\t * (MSI/PLLM  or HSE/PLLM when HSE is > 16MHz"
        ],
        [
          509,
          "\t\t * Booster clock frequency should be between 4 and 16MHz"
        ],
        [
          510,
          "\t\t * This is done in following steps:"
        ],
        [
          511,
          "\t\t * Read MSI Frequency or HSE oscillaor freq"
        ],
        [
          512,
          "\t\t * Divide PLL1 input freq (MSI/PLL or HSE/PLLM)"
        ],
        [
          513,
          "\t\t * by the targeted freq (8MHz)."
        ],
        [
          514,
          "\t\t * Make sure value is not higher than 16"
        ],
        [
          515,
          "\t\t * Shift in the register space (/2)"
        ],
        [
          516,
          "\t\t */"
        ],
        [
          517,
          "\t\tint tmp;"
        ],
        [
          518,
          ""
        ],
        [
          519,
          "\t\tif (IS_ENABLED(STM32_PLL_SRC_MSIS)) {"
        ],
        [
          520,
          "\t\t\ttmp = __LL_RCC_CALC_MSIS_FREQ(LL_RCC_MSIRANGESEL_RUN,"
        ],
        [
          521,
          "\t\t\t STM32_MSIS_RANGE << RCC_ICSCR1_MSISRANGE_Pos);"
        ],
        [
          522,
          "\t\t} else if (IS_ENABLED(STM32_PLL_SRC_HSE) && (MHZ(16) < STM32_HSE_FREQ)) {"
        ],
        [
          523,
          "\t\t\ttmp = STM32_HSE_FREQ;"
        ],
        [
          524,
          "\t\t} else {"
        ],
        [
          525,
          "\t\t\treturn;"
        ],
        [
          526,
          "\t\t}"
        ],
        [
          527,
          ""
        ],
        [
          528,
          "\t\ttmp = MIN(tmp / STM32_PLL_M_DIVISOR / 8000000, 16);"
        ],
        [
          529,
          "\t\ttmp = tmp / 2;"
        ],
        [
          530,
          ""
        ],
        [
          531,
          "\t\t/* Configure the epod clock frequency between 4 and 16 MHz */"
        ],
        [
          532,
          "\t\tLL_RCC_SetPll1EPodPrescaler(tmp << RCC_PLL1CFGR_PLL1MBOOST_Pos);"
        ],
        [
          533,
          ""
        ],
        [
          534,
          "\t\t/* Enable EPOD booster and wait for booster ready flag set */"
        ],
        [
          535,
          "\t\tLL_PWR_EnableEPODBooster();"
        ],
        [
          536,
          "\t\twhile (LL_PWR_IsActiveFlag_BOOST() == 0) {"
        ],
        [
          537,
          "\t\t}"
        ],
        [
          538,
          "\t}"
        ],
        [
          539,
          "}"
        ],
        [
          590,
          "\t\tLL_RCC_PLL1_SetMainSource(LL_RCC_PLL1SOURCE_MSIS);"
        ],
        [
          591,
          "\t} else if (IS_ENABLED(STM32_PLL_SRC_HSI)) {"
        ],
        [
          592,
          "\t\t/* Main PLL configuration and activation */"
        ],
        [
          593,
          "\t\tLL_RCC_PLL1_SetMainSource(LL_RCC_PLL1SOURCE_HSI);"
        ],
        [
          594,
          "\t} else {"
        ],
        [
          595,
          "\t\treturn -ENOTSUP;"
        ],
        [
          596,
          "\t}"
        ],
        [
          597,
          ""
        ],
        [
          598,
          "\t/*"
        ],
        [
          599,
          "\t * Configure the EPOD booster"
        ],
        [
          600,
          "\t * before increasing the system clock freq"
        ],
        [
          601,
          "\t * and after pll clock source is set"
        ],
        [
          602,
          "\t */"
        ],
        [
          603,
          "\tset_epod_booster();"
        ],
        [
          604,
          ""
        ],
        [
          605,
          "\tr = get_vco_input_range(STM32_PLL_M_DIVISOR, &vco_input_range, PLL1_ID);"
        ],
        [
          606,
          "\tif (r < 0) {"
        ],
        [
          607,
          "\t\treturn r;"
        ],
        [
          608,
          "\t}"
        ],
        [
          609,
          ""
        ],
        [
          610,
          "\tLL_RCC_PLL1_SetDivider(STM32_PLL_M_DIVISOR);"
        ],
        [
          611,
          ""
        ],
        [
          612,
          "\t/* Set VCO Input before enabling the PLL, depends on freq used for PLL1 */"
        ],
        [
          613,
          "\tLL_RCC_PLL1_SetVCOInputRange(vco_input_range);"
        ],
        [
          614,
          ""
        ],
        [
          615,
          "\tLL_RCC_PLL1_SetN(STM32_PLL_N_MULTIPLIER);"
        ],
        [
          616,
          ""
        ],
        [
          617,
          "\tLL_RCC_PLL1FRACN_Disable();"
        ]
      ]
    },
    {
