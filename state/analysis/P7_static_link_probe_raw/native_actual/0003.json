{"sequence":3,"phase":"native_validation","board":"2629958581","argv":["python3","-I","-B","-c","# Decodes and verifies the fixed remote helper before executing its source.\n# Keeps compressed command framing separate from the helper's public arguments.\n# Draft template: independent boundary tests and review must precede execution.\nimport base64\nimport hashlib\nimport sys\nimport zlib\n\nif len(sys.argv) < 2:\n    raise ValueError('Missing compressed helper argument')\nencoded = sys.argv[1]\ncompressed = base64.b64decode(encoded, validate=True)\nif base64.b64encode(compressed).decode('ascii') != encoded:\n    raise ValueError('Noncanonical helper base64')\ndecoder = zlib.decompressobj(zlib.MAX_WBITS)\nraw = decoder.decompress(compressed, 98304 + 1)\nif len(raw) > 98304:\n    raise ValueError('Helper source exceeds 98304 bytes')\nif not decoder.eof or decoder.unused_data or decoder.unconsumed_tail:\n    raise ValueError('Incomplete or trailing helper zlib stream')\nif hashlib.sha256(raw).hexdigest() != 'c6099f6d29ebdc400df5280032a8b5b0d229a003c594033a920f459316e2b8e7':\n    raise ValueError('Helper source SHA256 mismatch')\nsource = raw.decode('utf-8')\ndel sys.argv[1]\nexec(compile(source, '<static-remote>', 'exec'), {'__name__': '__main__'})\n","","","","","",""],"timeout":60,"start_utc":"2026-09-24T22:16:51.972462+00:00","end_utc":"2026-09-24T22:16:52.539802+00:00","returncode":0,"error":null,"stdout":"{\"base_sha256\":\"d30372dd4b8fb8c2661d00affc4a215cc88e3f62511995ff6303827bed4b7368\",\"claim\":{\"boot_id\":\"6d4aca1b-ac1f-4caf-b1ef-e127ce3956f6\",\"directories\":{\"artifacts\":{\"device\":66341,\"inode\":267651},\"build\":{\"device\":66341,\"inode\":267650},\"run\":{\"device\":66341,\"inode\":267649}},\"run_id\":\"f0220228320c4b2aa20c3e5e8264c813\"},\"error\":null,\"files\":{\"artifacts/app.ino.bin-zsk.bin\":{\"identity\":{\"bytes\":93096,\"ctime_ns\":1790285560899976917,\"device\":66341,\"inode\":268064,\"mtime_ns\":1790285560895976739},\"sha256\":\"5f08afe